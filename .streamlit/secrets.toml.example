# Copy this file to `.streamlit/secrets.toml` and fill in your real keys.
# NEVER commit `.streamlit/secrets.toml` to git (add it to .gitignore).
#
# You only need to fill in ONE key — the sidebar will only show providers
# for which a key is set. We recommend starting with Gemini or Groq (both free).

# Google Gemini (free) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "AIza..."

# Groq (free, very fast inference) — https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# Anthropic Claude (paid) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-api03-..."

# OpenAI (paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-proj-..."

# Zkopírujte tento soubor jako `.streamlit/secrets.toml` a doplňte skutečné klíče.
# Soubor `.streamlit/secrets.toml` NIKDY necommitujte do gitu (přidejte ho do .gitignore).
#
# Stačí vyplnit JEDEN klíč — v sidebaru aplikace se zobrazí jen ti poskytovatelé,
# pro které je klíč vyplněný. Doporučujeme začít s Gemini nebo Groq (oba zdarma).

# Google Gemini (zdarma) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "AIza..."

# Groq (zdarma, velmi rychlé inference) — https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# Anthropic Claude (placené) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-api03-..."

# OpenAI (placené) — https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-proj-..."
